    <worksheet name='Kpi 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#4e79a7' fontname='Tableau Bold' fontsize='9'>3. HIGH VALUE CHURN RATIO</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000'>Churn rate of top 20% customer by balance</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Bank_data_new_file' name='federated.0lgg8w707tnatk12kdyi80yk7cx7' />
          </datasources>
          <datasource-dependencies datasource='federated.0lgg8w707tnatk12kdyi80yk7cx7'>
            <column caption='Age group' datatype='string' name='[Age_group]' role='dimension' type='nominal' />
            <column caption='Balance group' datatype='string' name='[Balance_group]' role='dimension' type='nominal' />
            <column caption='High value churn ' datatype='integer' default-format='p0.00%' name='[Calculation_1482247259592966148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Balance_group])=&quot;High_balance&quot; &#13;&#10;Then 1&#13;&#10;Else 0&#13;&#10;END' />
            </column>
            <column caption='High balance churn' datatype='integer' name='[Calculation_1482247259599532037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Balance_group] = &quot;High_balance&quot;&#13;&#10;AND [Exited] = 1&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Ratio of churn of high balance' datatype='real' name='[Calculation_1482247259600650246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1482247259599532037])/SUM([Calculation_1482247259592966148])' />
